SITE_URL=http://localhost:3000
# Remains preview until the separately approved domain migration.
SITE_MODE=preview
# sanity = real CMS; local = explicit, isolated offline fixtures.
CONTENT_SOURCE=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=4d7wgp7e
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-09-27
# Viewer token: Sanity project > API > Tokens. Needed only for drafts.
SANITY_API_READ_TOKEN=
# Editor token: one-time initial migration only; remove afterwards.
SANITY_API_WRITE_TOKEN=
# Optional, only loads after visitor consent; leave empty for staging.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
